DATABASE_URL=postgresql+psycopg2://investad:investad@localhost:5433/investad
GEMINI_API_KEY=
GROQ_API_KEY=
# FRED (free, instant): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# NewsAPI (free tier, instant): https://newsapi.org/register
NEWSAPI_KEY=
CHROMA_PERSIST_DIR=./chroma_db
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated origins allowed to call the API directly (the Vite dev proxy does not need this)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password-reset e-mail (optional). Leave SMTP_HOST empty to hide "Forgot password?".
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=<you>@gmail.com, SMTP_PASSWORD=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Base URL the reset link points at (the deployed site in production)
APP_BASE_URL=http://localhost:5173
